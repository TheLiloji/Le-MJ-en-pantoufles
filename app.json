{
  "expo": {
    "name": "MjEnPantoufles - Grimoire D&D",
    "slug": "mj-en-pantoufles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mj-en-pantoufles",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F2937"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mjenpantoufles.grimoire",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "MjEnPantoufles",
        "CFBundleName": "MjEnPantoufles",
        "NSCameraUsageDescription": "Cette app n'utilise pas la caméra",
        "NSPhotoLibraryUsageDescription": "Cette app n'accède pas à la galerie"
      }
    },
    "android": {
      "package": "com.mjenpantoufles.grimoire",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1F2937"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
